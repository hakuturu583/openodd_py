# The Rust extension (``openodd._core``). The Python modules of this package
# wrap it and carry the types; the classes they name are declared here.
from typing import Any, Optional

class OpenOddError(ValueError): ...
class UnitError(ValueError): ...
class GitSourceError(ValueError): ...

class Condition:
    def describe(self) -> str: ...
    def evaluate(self, values: dict[str, Any], truth: Optional[dict[str, Any]] = None) -> Any: ...
    def attributes(self) -> list[str]: ...
    def references(self) -> list[str]: ...

class MergedEntry:
    name: str
    group: str
    kind: str
    event: str
    text: str
    target: float
    buckets: list[str]
    unit: str
    items: list[str]
    hits: dict[str, int]
    runs: dict[str, int]
    hit_by: dict[str, list[int]]
    out_of_range: dict[str, int]
    samples: int
    ignored: int
    outside: list[str]
    cover_by: str
    min_stay: Optional[float]
    targets: list[str]
    covered: list[str]
    holes: list[str]
    grade: float
    def amount(self, bucket: str) -> float: ...
    def is_covered(self, bucket: str) -> bool: ...
    def exposure_of(self, bucket: str) -> dict[str, Optional[float]]: ...
    def to_json(self) -> str: ...

class Units:
    def __init__(self) -> None: ...
    def add_conversions(self, conversion: dict[str, Any]) -> None: ...
    def unit_type(self, unit: str) -> Optional[str]: ...
    def convert(self, value: float, from_unit: str, to_unit: str) -> float: ...
    def check_type(self, unit: str, unit_type: str) -> None: ...

class Cells:
    def __init__(self, odd: Any) -> None: ...
    @property
    def attributes(self) -> list[str]: ...
    @property
    def ticks(self) -> int: ...
    def cell_of(self, values: list[Any]) -> list[str]: ...
    def add(self, values: list[Any], seconds: float = 0.0, meters: float = 0.0) -> list[str]: ...
    def to_json(self) -> str: ...

UNDECIDED: Any
CACHE_ENV: str
MISSING: str
CELL_MIN_RUNS: int
CELL_BAND: tuple[float, float]
MAX_CELL_ROWS: int

class CoverageView:
    def __init__(self, documents_json: str) -> None: ...
    @property
    def attributes(self) -> list[str]: ...
    @property
    def scenarios(self) -> list[str]: ...
    @property
    def environments(self) -> list[Optional[str]]: ...
    @property
    def runs(self) -> int: ...
    def matrix_json(self, query_json: str) -> str: ...
    def fragment(
        self, query_json: str, id: str = "", link: Optional[str] = None,
        labels: Optional[dict[str, str]] = None,
    ) -> str: ...
    def explorer(
        self, query_json: str, depth: int = 2, id: str = "",
        labels: Optional[dict[str, str]] = None,
    ) -> str: ...

class CasePlot:
    def __init__(self, documents_json: str) -> None: ...
    @property
    def attributes(self) -> list[str]: ...
    @property
    def scenarios(self) -> list[str]: ...
    @property
    def cases(self) -> int: ...
    @property
    def runs(self) -> int: ...
    @property
    def skipped(self) -> tuple[int, int]: ...
    def data_json(self, query_json: str, prediction: bool = True) -> str: ...
    def fragment(
        self, query_json: str, id: str = "", link: Optional[str] = None, table: bool = True,
        prediction: bool = True, rings: bool = False, labels: Optional[dict[str, str]] = None,
        extra_json: str = "{}",
    ) -> str: ...
    def table(self, query_json: str, id: str = "", labels: Optional[dict[str, str]] = None) -> str: ...
    def explorer(
        self, query_json: str, id: str = "", table: bool = True, prediction: bool = True,
        rings: bool = False, labels: Optional[dict[str, str]] = None, extra_json: str = "{}",
    ) -> str: ...
    def drift_json(self, query_json: str, extra_json: str = "{}") -> str: ...
    def drift_html(
        self, query_json: str, id: str = "", labels: Optional[dict[str, str]] = None,
        extra_json: str = "{}",
    ) -> str: ...

def coverage_view_styles() -> str: ...
def coverage_view_script() -> str: ...
def coverage_view_page(title: str, body: str) -> str: ...
def wilson_interval(failed: int, runs: int, z: float = ...) -> tuple[float, float]: ...
def cell_status(runs: int, failed: int, min_runs: int, low: float, high: float) -> str: ...

class ParamSpace:
    def __init__(
        self, dims: list[tuple[str, str, Optional[tuple[float, float]], Optional[list[str]]]]
    ) -> None: ...
    @property
    def dims(self) -> list[tuple[str, str, Optional[tuple[float, float]], Optional[list[str]]]]: ...
    def to_json(self) -> str: ...
    @staticmethod
    def from_json(raw: str) -> "ParamSpace": ...
    def encode(self, values: dict[str, Any]) -> list[float]: ...

class FlakinessModel:
    def __init__(
        self,
        space: ParamSpace,
        *,
        seed: str = "0",
        threshold: float = 0.1,
        epsilon: float = 0.05,
        perturbations: int = 32,
        draws: int = 256,
        directions: int = 16,
    ) -> None: ...
    def observe(self, values: dict[str, Any], passed: bool) -> None: ...
    def metrics(self, values: dict[str, Any]) -> tuple[float, float, float, Optional[float]]: ...
    def kernel(self) -> tuple[list[float], float, float]: ...
    def ranking(self) -> list[tuple[int, tuple[float, float, float, Optional[float]]]]: ...

class RuleSet:
    @staticmethod
    def parse(text: str, source: str) -> RuleSet: ...
    def merged(self, over: RuleSet) -> RuleSet: ...
    @property
    def quantities(self) -> list[str]: ...
    def inputs(self, quantity: str) -> list[str]: ...
    def outputs(self, quantity: str) -> list[str]: ...
    def source(self, quantity: str) -> str: ...
    def evaluate(self, quantity: str, inputs: dict[str, float]) -> dict[str, float]: ...
    def check_inputs(self, allowed: list[str]) -> None: ...

def convert(value: float, from_unit: str, to_unit: str) -> float: ...
def normalize_unit(unit: str) -> str: ...
def value_label(value: Any) -> str: ...
def __getattr__(name: str) -> Any: ...
