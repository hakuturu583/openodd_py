# The Rust extension (``openodd._core``). The Python modules of this package
# wrap it and carry the types; the classes they name are declared here.
from typing import Any, Optional

class OpenOddError(ValueError): ...
class UnitError(ValueError): ...
class GitSourceError(ValueError): ...

class Condition:
    def describe(self) -> str: ...
    def evaluate(self, values: dict[str, Any], truth: Optional[dict[str, Any]] = None) -> Any: ...
    def attributes(self) -> list[str]: ...
    def references(self) -> list[str]: ...

class MergedEntry:
    name: str
    group: str
    kind: str
    event: str
    text: str
    target: float
    buckets: list[str]
    unit: str
    items: list[str]
    hits: dict[str, int]
    runs: dict[str, int]
    hit_by: dict[str, list[int]]
    out_of_range: dict[str, int]
    samples: int
    ignored: int
    outside: list[str]
    cover_by: str
    min_stay: Optional[float]
    targets: list[str]
    covered: list[str]
    holes: list[str]
    grade: float
    def amount(self, bucket: str) -> float: ...
    def is_covered(self, bucket: str) -> bool: ...
    def exposure_of(self, bucket: str) -> dict[str, Optional[float]]: ...
    def to_json(self) -> str: ...

class Units:
    def __init__(self) -> None: ...
    def add_conversions(self, conversion: dict[str, Any]) -> None: ...
    def unit_type(self, unit: str) -> Optional[str]: ...
    def convert(self, value: float, from_unit: str, to_unit: str) -> float: ...
    def check_type(self, unit: str, unit_type: str) -> None: ...

UNDECIDED: Any
CACHE_ENV: str

def convert(value: float, from_unit: str, to_unit: str) -> float: ...
def normalize_unit(unit: str) -> str: ...
def value_label(value: Any) -> str: ...
def __getattr__(name: str) -> Any: ...
